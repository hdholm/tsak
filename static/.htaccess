Header set Content-Security-Policy "default-src 'none' ; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' ; object-src 'none' ; style-src 'unsafe-inline' 'self' ; img-src 'self' data: ; connect-src 'self' ; media-src 'self' ; frame-src 'none' ; frame-ancestors 'none' ; font-src 'self' ; manifest-src 'self' ; worker-src 'self' ; form-action 'self' ; base-uri 'self' "
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Strict-Transport-Security "max-age=31536000"

ErrorDocument 400 /tsak/404.html
ErrorDocument 401 /tsak/404.html
ErrorDocument 403 /tsak/404.html
ErrorDocument 404 /tsak/404.html
