Header set Content-Security-Policy "default-src 'none' ; script-src 'self' 'unsafe-inline' 'unsafe-eval' ; object-src 'self' ; style-src 'unsafe-inline' 'self' ; img-src 'self' data: ; connect-src 'self' ; media-src 'self' ; frame-src 'none' ; frame-ancestors 'none' ; font-src 'self' ; manifest-src 'self' ; worker-src 'self' ; form-action 'self' ; base-uri 'self' ; block-all-mixed-content"
ErrorDocument 400 /tsak/404.html
ErrorDocument 401 /tsak/404.html
ErrorDocument 403 /tsak/404.html
ErrorDocument 404 /tsak/404.html
